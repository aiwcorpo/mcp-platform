  "authenticationFlows": [
    {
      "alias": "browser-mcp",
      "description": "Browser login with step-up: level 1 password, level 2 password and OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-mcp forms"
        }
      ]
    },
    {
      "alias": "browser-mcp forms",
      "description": "Level conditions",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-mcp level 1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-mcp level 2"
        }
      ]
    },
    {
      "alias": "browser-mcp level 1",
      "description": "Password, then the OTP of a user who has one (before any required action or application-initiated action)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "mcp-loa-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-mcp level 1 otp"
        }
      ]
    },
    {
      "alias": "browser-mcp level 1 otp",
      "description": "OTP of a user who has one; a user without one is not asked, and enrolls through the required action",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "browser-mcp level 2",
      "description": "Second factor: asked here unless this login already used an OTP at level 1; a user without an OTP is refused. The last element makes a flow whose conditional parts were all skipped succeed (an empty flow fails).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "mcp-loa-2"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-mcp otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-mcp otp missing"
        },
        {
          "requirement": "REQUIRED",
          "priority": 40,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "allow-access-authenticator"
        }
      ]
    },
    {
      "alias": "browser-mcp otp",
      "description": "OTP at level 2, when this login has not used one yet",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 5,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-credential",
          "authenticatorConfig": "mcp-otp-unused"
        },
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "browser-mcp otp missing",
      "description": "Level 2 without any OTP used in this login: refused",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-credential",
          "authenticatorConfig": "mcp-otp-unused"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "mcp-no-otp-message"
        }
      ]
    }
  ],
  "authenticatorConfig": [
