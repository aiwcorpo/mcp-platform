# Configuration of the platform. Copy this file to .env (Compose reads .env next to compose.yaml), fill in the empty value
# and start with "docker compose up -d". Passwords, keys and certificates inside the platform are generated on the first
# start and kept in Docker volumes; nothing of that belongs in this file.
#
# Also needed, in certs/ (or in the directory MCP_CERTS_DIR names): tls.crt (the certificate chain of the domain) and tls.key. Only when that certificate is not
# from a public CA: company-ca.crt, the CA certificate(s) that signed it.

# The name users type in the browser and in their AI client, in lower case. The certificate in certs/tls.crt must name it.
MCP_DOMAIN=

# First platform administrator (group mcp-platform-admin). Its initial password is generated: see README.md, Install.
# MCP_ADMIN_USERNAME=mcp-admin
# MCP_CERTS_DIR=./certs

# Public ports of nginx, the only service that publishes any. 443 and 80 (redirect to https) by default.
# MCP_HTTPS_PORT=443
# MCP_HTTP_PORT=80
# MCP_BIND=0.0.0.0
# Only when the https port is not 443: the origin with that port, the one users see.
# MCP_PUBLIC_ORIGIN=https://<domain>:<port>

# The port Claude Code listens on for the login callback; the portal shows it in the command it gives to users.
# MCP_CLAUDE_CODE_CALLBACK_PORT=33418

# CAs that sign the certificates of MCP servers on other hosts: a PEM file on this host, added to what the gateway trusts (the public
# CAs and certs/company-ca.crt are trusted without it). A server whose certificate chains to one of them, for the host name of its
# address, is trusted as "ca" and its renewals need no approval. Other servers are pinned by the fingerprint of their certificate.
# MCP_SERVER_TRUSTED_CAS_FILE=/etc/mcp/servers-ca.pem

# Versions of the platform's images.
# MCP_GATEWAY_VERSION=2.0.1
# MCP_BROKER_VERSION=2.0.0
# MCP_PORTAL_VERSION=2.0.1

# Closed network: copy the images to your registry and name it here. MCP_REGISTRY holds mcp-gateway, mcp-credential-broker,
# mcp-portal and the MCP servers; MCP_THIRD_PARTY_REGISTRY holds postgres, redis, nginx, eclipse-temurin, keycloak and openbao
# under their plain names. PULL_POLICY=never when the images are loaded by hand.
# MCP_REGISTRY=ghcr.io/aiwcorpo
# MCP_THIRD_PARTY_REGISTRY=
# PULL_POLICY=missing

# Memory limits.
# GATEWAY_MEM_LIMIT=2g
# BROKER_MEM_LIMIT=1g
# PORTAL_MEM_LIMIT=1g
# KEYCLOAK_MEM_LIMIT=2g
# NGINX_MEM_LIMIT=512m
